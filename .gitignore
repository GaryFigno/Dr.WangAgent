# User / project harness config that may embed accounts or proxies
.aiharness.yaml
.aiharness.yml
config.yaml
config.local.yaml
**/config.local.yaml

# Runtime project state (sessions, memories, screenshots, …)
# Rules under .aiharness/rules are source-controlled; everything else is not.
.aiharness/*
!.aiharness/rules/
.claude/

# Local scratch: live API probes, message dumps, downloaded API schemas.
# Contains real conversations / account data — never publish.
.cursor-tmp/
**/.cursor-tmp/

# --- Skills that may carry API keys or private tooling ---
# Put any skill that embeds keys, tokens, or vendor secrets here.
skills.private/
.private-skills/
**/skills.private/
**/skills/**/.env
**/skills/**/.env.*
**/skills/**/secrets/
**/skills/**/credentials*
**/skills/**/*api*key*
**/SKILL.md.local

